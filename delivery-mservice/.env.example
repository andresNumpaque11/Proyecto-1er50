APP_NAME=delivery-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
MONGO_URI=mongodb://mongo-delivery:27018/?directConnection=true
MONGO_DATABASE=delivery_service
ROUTE_MAX_STOPS=10
ROUTE_MAX_WAIT_SECONDS=600
ROUTE_PLANNER_INTERVAL_SECONDS=10
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=50
EVENT_PUBLISHER_MODE=rabbitmq
EVENT_PUBLISHER_URL=
EVENT_PUBLISHER_TIMEOUT_SECONDS=5
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=sigtam.events
EUREKA_SERVER=http://api-gateway:8761/eureka/
EUREKA_INSTANCE_HOST=delivery-mservice
EUREKA_INSTANCE_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=REPLACE_WITH_THE_SAME_SECRET_AS_USERS_SERVICE
AUTH_SERVICE_URL=http://localhost:8000
